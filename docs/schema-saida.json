{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "trecho": {
          "minLength": 1,
          "title": "Trecho",
          "type": "string"
        }
      },
      "required": [
        "id",
        "trecho"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "resultado": {
      "maxLength": 1800,
      "minLength": 1,
      "title": "Resultado",
      "type": "string"
    },
    "fontes": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Fontes",
      "type": "array"
    },
    "suficiente": {
      "title": "Suficiente",
      "type": "boolean"
    },
    "categoria": {
      "anyOf": [
        {
          "enum": [
            "Acesso / Conta",
            "Rede / Conectividade",
            "Software / Sistema",
            "Hardware / Equipamento",
            "Solicitação Informativa"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Categoria"
    },
    "prioridade": {
      "anyOf": [
        {
          "enum": [
            "Baixa",
            "Média",
            "Alta",
            "Crítica"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prioridade"
    },
    "encaminhamento": {
      "anyOf": [
        {
          "enum": [
            "Suporte N1",
            "Infraestrutura",
            "Sistemas",
            "Suporte N2"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Encaminhamento"
    },
    "perguntas": {
      "items": {
        "type": "string"
      },
      "title": "Perguntas",
      "type": "array"
    },
    "registrar": {
      "title": "Registrar",
      "type": "boolean"
    },
    "motivo_termino": {
      "title": "Motivo Termino",
      "type": "string"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "registro_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registro Id"
    },
    "ja_existia": {
      "default": false,
      "title": "Ja Existia",
      "type": "boolean"
    },
    "pendencia": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pendencia"
    }
  },
  "required": [
    "resultado",
    "fontes",
    "suficiente",
    "categoria",
    "prioridade",
    "encaminhamento",
    "perguntas",
    "registrar",
    "motivo_termino",
    "thread_id"
  ],
  "title": "Output",
  "type": "object"
}